@@ -0,0 +1,194 @@
+import type { Room } from "livekit-client";
+import { createEffect, createSignal, onCleanup } from "solid-js";
+
+import { useClient } from "@revolt/client";
+
+import { useVoice } from "./state";
+
+/** LiveKit data-channel topic used for soundboard triggers */
+export const SOUNDBOARD_TOPIC = "soundboard";
+
+/** Auth header tuple as provided by client.authenticationHeader */
+type Auth = [string, string];
+
+/** One soundboard entry as returned by the soundboard service */
+export type SoundboardSound = {
+  id: string;
+  label: string;
+  builtin: boolean;
+  canDelete: boolean;
+};
+
+const [soundboardOpen, setSoundboardOpen] = createSignal(false);
+const [soundboardSounds, setSoundboardSounds] = createSignal<
+  SoundboardSound[]
+>([]);
+const [soundboardError, setSoundboardError] = createSignal<string>();
+
+function loadVolume(): number {
+  try {
+    const v = parseFloat(localStorage.getItem("soundboard:volume") ?? "");
+    if (Number.isFinite(v) && v >= 0 && v <= 1) return v;
+  } catch {
+    /* ignore */
+  }
+  return 0.6;
+}
+
+const [soundboardVolume, setSoundboardVolumeRaw] = createSignal(loadVolume());
+const [soundboardMuted, setSoundboardMuted] = createSignal(false);
+
+function setSoundboardVolume(v: number) {
+  setSoundboardVolumeRaw(v);
+  try {
+    localStorage.setItem("soundboard:volume", String(v));
+  } catch {
+    /* ignore */
+  }
+}
+
+export {
+  soundboardOpen,
+  setSoundboardOpen,
+  soundboardSounds,
+  soundboardError,
+  setSoundboardError,
+  soundboardVolume,
+  setSoundboardVolume,
+  soundboardMuted,
+  setSoundboardMuted,
+};
+
+/** Cache of sound id -> object URL so each clip is fetched once */
+const urlCache = new Map<string, string>();
+
+async function soundUrl(id: string, auth: Auth): Promise<string> {
+  const cached = urlCache.get(id);
+  if (cached) return cached;
+  const [header, value] = auth;
+  const res = await fetch(`/soundboard/files/${encodeURIComponent(id)}`, {
+    headers: { [header]: value },
+  });
+  if (!res.ok) throw new Error(`soundboard file ${id}: ${res.status}`);
+  const url = URL.createObjectURL(await res.blob());
+  urlCache.set(id, url);
+  return url;
+}
+
+/** Play a soundboard clip locally (respects local volume / mute) */
+export async function playSoundboardSound(id: string, auth: Auth) {
+  if (soundboardMuted()) return;
+  try {
+    const audio = new Audio(await soundUrl(id, auth));
+    audio.volume = soundboardVolume();
+    void audio.play();
+  } catch {
+    /* clip unavailable; stay silent */
+  }
+}
+
+/** Broadcast a trigger to everyone in the call, and play it locally too */
+export function triggerSoundboardSound(
+  room: Room | undefined,
+  auth: Auth,
+  id: string,
+) {
+  try {
+    room?.localParticipant.publishData(
+      new TextEncoder().encode(JSON.stringify({ id })),
+      { reliable: true, topic: SOUNDBOARD_TOPIC },
+    );
+  } catch {
+    /* still play locally below */
+  }
+  void playSoundboardSound(id, auth);
+}
+
+/** Refresh the pad list from the soundboard service */
+export async function refreshSoundboard(auth: Auth) {
+  try {
+    const [header, value] = auth;
+    const res = await fetch("/soundboard/list", {
+      headers: { [header]: value },
+    });
+    if (!res.ok) throw new Error(String(res.status));
+    setSoundboardSounds((await res.json()) as SoundboardSound[]);
+    setSoundboardError(undefined);
+  } catch {
+    setSoundboardError("Soundboard unavailable");
+  }
+}
+
+/** Upload a clip; server enforces the 10 second / 2 MB limits */
+export async function uploadSoundboardSound(auth: Auth, file: File) {
+  const [header, value] = auth;
+  const body = new FormData();
+  body.append("file", file);
+  const res = await fetch("/soundboard/upload", {
+    method: "POST",
+    headers: { [header]: value },
+    body,
+  });
+  if (!res.ok) {
+    let message = "Upload failed";
+    try {
+      message = ((await res.json()) as { error?: string }).error ?? message;
+    } catch {
+      /* keep default */
+    }
+    throw new Error(message);
+  }
+  await refreshSoundboard(auth);
+}
+
+/** Delete a clip (server allows uploader or admin only) */
+export async function deleteSoundboardSound(auth: Auth, id: string) {
+  const [header, value] = auth;
+  await fetch(`/soundboard/sounds/${encodeURIComponent(id)}`, {
+    method: "DELETE",
+    headers: { [header]: value },
+  });
+  await refreshSoundboard(auth);
+}
+
+/**
+ * Mounted inside the voice context while in a room; listens for soundboard
+ * triggers from other participants and plays them locally.
+ */
+export function SoundboardManager() {
+  const voice = useVoice();
+  const client = useClient();
+
+  createEffect(() => {
+    const room = voice.room();
+    if (!room) return;
+
+    const handler = (
+      payload: Uint8Array,
+      _participant?: unknown,
+      _kind?: unknown,
+      topic?: string,
+    ) => {
+      if (topic !== SOUNDBOARD_TOPIC) return;
+      try {
+        const message = JSON.parse(new TextDecoder().decode(payload)) as {
+          id?: string;
+        };
+        if (message?.id)
+          void playSoundboardSound(
+            String(message.id),
+            client()!.authenticationHeader as Auth,
+          );
+      } catch {
+        /* malformed message; ignore */
+      }
+    };
+
+    room.on("dataReceived", handler);
+    onCleanup(() => {
+      room.off("dataReceived", handler);
+    });
+  });
+
+  return null;
+}
