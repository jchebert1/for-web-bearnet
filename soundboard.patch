+import { For, Show, createSignal, onMount } from "solid-js";
+
+import { useLingui } from "@lingui/solid/macro";
+import { styled } from "styled-system/jsx";
+
+import { useClient } from "@revolt/client";
+import { useVoice } from "@revolt/rtc";
+import {
+  deleteSoundboardSound,
+  refreshSoundboard,
+  setSoundboardMuted,
+  setSoundboardVolume,
+  soundboardError,
+  soundboardMuted,
+  soundboardSounds,
+  soundboardVolume,
+  triggerSoundboardSound,
+  uploadSoundboardSound,
+} from "@revolt/rtc/Soundboard";
+import { IconButton } from "@revolt/ui/components/design";
+import { Symbol } from "@revolt/ui/components/utils/Symbol";
+
+/**
+ * Soundboard panel shown inside the call card
+ */
+export function VoiceCallCardSoundboard() {
+  const voice = useVoice();
+  const client = useClient();
+  const { t } = useLingui();
+
+  const auth = () => client()!.authenticationHeader as [string, string];
+
+  const [busy, setBusy] = createSignal(false);
+  const [message, setMessage] = createSignal<string>();
+
+  let fileInput: HTMLInputElement | undefined;
+
+  onMount(() => void refreshSoundboard(auth()));
+
+  async function onFilePicked() {
+    const file = fileInput?.files?.[0];
+    if (!file) return;
+    setBusy(true);
+    setMessage(undefined);
+    try {
+      await uploadSoundboardSound(auth(), file);
+    } catch (err) {
+      setMessage(err instanceof Error ? err.message : "Upload failed");
+    } finally {
+      setBusy(false);
+      if (fileInput) fileInput.value = "";
+    }
+  }
+
+  return (
+    <Panel>
+      <Header>
+        <Title>{t`Soundboard`}</Title>
+        <Controls>
+          <VolumeSlider
+            type="range"
+            min="0"
+            max="100"
+            value={Math.round(soundboardVolume() * 100)}
+            onInput={(e) =>
+              setSoundboardVolume(parseInt(e.currentTarget.value, 10) / 100)
+            }
+          />
+          <IconButton
+            size="xs"
+            variant={soundboardMuted() ? "filled" : "standard"}
+            onPress={() => setSoundboardMuted(!soundboardMuted())}
+            use:floating={{
+              tooltip: {
+                placement: "top",
+                content: soundboardMuted()
+                  ? t`Unmute soundboard (only for you)`
+                  : t`Mute soundboard (only for you)`,
+              },
+            }}
+          >
+            <Symbol>
+              {soundboardMuted() ? "volume_off" : "volume_up"}
+            </Symbol>
+          </IconButton>
+        </Controls>
+      </Header>
+      <Show when={soundboardError() || message()}>
+        <Message>{soundboardError() ?? message()}</Message>
+      </Show>
+      <Pads>
+        <For each={soundboardSounds()}>
+          {(sound) => (
+            <Pad
+              onClick={() =>
+                triggerSoundboardSound(voice.room(), auth(), sound.id)
+              }
+            >
+              <PadLabel>{sound.label}</PadLabel>
+              <Show when={sound.canDelete}>
+                <DeleteButton
+                  onClick={(e) => {
+                    e.stopPropagation();
+                    void deleteSoundboardSound(auth(), sound.id);
+                  }}
+                >
+                  <Symbol>close</Symbol>
+                </DeleteButton>
+              </Show>
+            </Pad>
+          )}
+        </For>
+        <UploadPad
+          onClick={() => !busy() && fileInput?.click()}
+          disabled={busy()}
+        >
+          <Symbol>add</Symbol>
+          <PadLabel>{busy() ? t`Uploading…` : t`Upload · 10s max`}</PadLabel>
+        </UploadPad>
+      </Pads>
+      <input
+        ref={fileInput}
+        type="file"
+        accept="audio/*,.mp3,.ogg,.wav,.m4a"
+        style={{ display: "none" }}
+        onChange={() => void onFilePicked()}
+      />
+    </Panel>
+  );
+}
+
+const Panel = styled("div", {
+  base: {
+    flexShrink: 0,
+    maxHeight: "45%",
+    display: "flex",
+    flexDirection: "column",
+    gap: "var(--gap-sm)",
+    padding: "var(--gap-md)",
+    borderRadius: "var(--borderRadius-lg)",
+    background: "var(--md-sys-color-surface-container)",
+    overflowY: "auto",
+  },
+});
+
+const Header = styled("div", {
+  base: {
+    display: "flex",
+    alignItems: "center",
+    justifyContent: "space-between",
+    gap: "var(--gap-md)",
+  },
+});
+
+const Title = styled("span", {
+  base: {
+    fontSize: "0.8rem",
+    fontWeight: 600,
+    textTransform: "uppercase",
+    letterSpacing: "0.08em",
+    color: "var(--md-sys-color-on-surface-variant)",
+  },
+});
+
+const Controls = styled("div", {
+  base: {
+    display: "flex",
+    alignItems: "center",
+    gap: "var(--gap-sm)",
+  },
+});
+
+const VolumeSlider = styled("input", {
+  base: {
+    width: "90px",
+    accentColor: "var(--md-sys-color-primary)",
+  },
+});
+
+const Message = styled("div", {
+  base: {
+    fontSize: "0.8rem",
+    color: "var(--md-sys-color-error)",
+  },
+});
+
+const Pads = styled("div", {
+  base: {
+    display: "grid",
+    gridTemplateColumns: "repeat(auto-fill, minmax(96px, 1fr))",
+    gap: "var(--gap-sm)",
+  },
+});
+
+const Pad = styled("button", {
+  base: {
+    position: "relative",
+    display: "flex",
+    flexDirection: "column",
+    alignItems: "center",
+    justifyContent: "center",
+    gap: "var(--gap-xs)",
+    padding: "var(--gap-md) var(--gap-sm)",
+    borderRadius: "var(--borderRadius-md)",
+    background: "var(--md-sys-color-surface-container-high)",
+    color: "var(--md-sys-color-on-surface)",
+    cursor: "pointer",
+    border: "none",
+    transition: "background var(--transitions-fast)",
+    _hover: {
+      background: "var(--md-sys-color-surface-container-highest)",
+    },
+    _active: {
+      transform: "translateY(1px)",
+    },
+  },
+});
+
+const UploadPad = styled("button", {
+  base: {
+    display: "flex",
+    flexDirection: "column",
+    alignItems: "center",
+    justifyContent: "center",
+    gap: "var(--gap-xs)",
+    padding: "var(--gap-md) var(--gap-sm)",
+    borderRadius: "var(--borderRadius-md)",
+    background: "transparent",
+    color: "var(--md-sys-color-on-surface-variant)",
+    cursor: "pointer",
+    border: "1px dashed var(--md-sys-color-outline)",
+  },
+});
+
+const PadLabel = styled("span", {
+  base: {
+    fontSize: "0.72rem",
+    maxWidth: "100%",
+    overflow: "hidden",
+    textOverflow: "ellipsis",
+    whiteSpace: "nowrap",
+  },
+});
+
+const DeleteButton = styled("span", {
+  base: {
+    position: "absolute",
+    top: "2px",
+    insetInlineEnd: "2px",
+    display: "flex",
+    borderRadius: "var(--borderRadius-full)",
+    color: "var(--md-sys-color-on-surface-variant)",
+    opacity: 0.6,
+    fontSize: "0.7rem",
+    _hover: {
+      opacity: 1,
+      color: "var(--md-sys-color-error)",
+    },
+  },
+});
